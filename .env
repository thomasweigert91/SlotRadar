# CleverQ Bot Konfiguration

# Standort (URL-Slug)
SITE_SLUG=norderstedt

# Service-ID (Norderstedt = 280)
SERVICE_ID=280

# Subtask-ID (191 = Zulassung/Umschreibung eines Fahrzeuges)
# Alle verfügbaren IDs anzeigen mit: npm run list
SUBTASK_ID=191

# Anzahl der Vorgänge
SUBTASK_COUNT=1

# Suchzeitraum ab heute in Wochen (Standard: 12 Wochen)
WEEKS_AHEAD=1

# Prüf-Intervall in Sekunden (Standard: 30)
CHECK_INTERVAL_SECONDS=30

# Benachrichtigungen (true / false)
SOUND_ALERT=true
DESKTOP_NOTIFICATION=true
AUTO_OPEN_BROWSER=true

# Optional: Telegram Benachrichtigung (auf Smartphone)
# 1. Erstelle einen Bot bei @BotFather in Telegram -> Bot Token
# 2. Sende eine Nachricht an deinen Bot und hole deine Chat-ID bei @userinfobot
TELEGRAM_BOT_TOKEN=8637397605:AAFetIwrnVJ7Kq7Z3XNKPzsl9YLAV6NP_IU
TELEGRAM_CHAT_ID=8496919884

# Optional: Discord Webhook
DISCORD_WEBHOOK_URL=

# Optional: Manueller Fallback-Key (falls nötig)
BOOKING_SESSION_KEY=QMZ8NYgjIh7trKzPjEYVg

